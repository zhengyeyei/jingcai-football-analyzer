# ==================== 数据库配置 ====================
# SQLite
DATABASE_URL=sqlite:///./data/football.db

# MySQL (可选)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/jingcai_db

# ==================== API配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ==================== 爬虫配置 ====================
# 数据源URL
MATCH_DATA_SOURCE=https://api.sports.com/matches
ODDS_DATA_SOURCE=https://api.odds.com/odds

# 爬虫延迟（秒）
CRAWL_DELAY=2
CRAWL_TIMEOUT=10

# ==================== 模型配置 ====================
# 模型类型
MODEL_TYPE=ensemble  # poisson, ml, ensemble

# XGBoost参数
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.1
XGB_N_ESTIMATORS=100

# ==================== 投注策略配置 ====================
# 初始资金
INITIAL_BANKROLL=10000

# 凯利公式系数（0.0-1.0，越小越保守）
KELLY_FRACTION=0.25

# 最小赔率
MIN_ODDS=1.5

# 最大赔率
MAX_ODDS=10.0

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==================== 其他配置 ====================
# 时区
TIMEZONE=Asia/Shanghai

# 密钥（用于数据加密）
SECRET_KEY=your-secret-key-here-change-in-production
